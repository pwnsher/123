# Gem Radar environment variables — names only, no values. Copy to your shell profile
# or a secrets manager; never commit filled-in values. All are optional.
# Solana JSON-RPC endpoint (may embed a provider key; never logged)
SOLANA_RPC_URL=
# EVM JSON-RPC endpoints per chain (default: publicnode.com public endpoints)
GEM_RADAR_RPC_ETHEREUM=
GEM_RADAR_RPC_BSC=
GEM_RADAR_RPC_BASE=
GEM_RADAR_RPC_ARBITRUM=
GEM_RADAR_RPC_POLYGON=
GEM_RADAR_RPC_OPTIMISM=
GEM_RADAR_RPC_AVALANCHE=
# Honeypot.is API key (optional; sent as X-API-KEY)
HONEYPOT_IS_API_KEY=
# Where history/watchlist/cache live (default ~/.gem-radar)
GEM_RADAR_HOME=
# Local fallback data folder (default ./radar-data)
GEM_RADAR_DATA_DIR=
# Path to a JSON config overriding config.example.json defaults
GEM_RADAR_CONFIG=
# Set to 1 to forbid all network requests
GEM_RADAR_OFFLINE=
