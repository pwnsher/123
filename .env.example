# .env.example — NAMES AND PLACEHOLDERS ONLY. Never put real values in this file.
# Copy to .env (git-ignored) or set in PowerShell:  $env:NAME = "value"
# Nothing here is required for local operation: `py run_local.py` runs with none of them set.

# ---- local runner (infrastructure) ----
KALSHI_LOG_LEVEL=INFO                 # DEBUG shows every per-cycle decision
KALSHI_LOG_FORMAT=text                # text (key=value) | json
KALSHI_LOG_FILE=                      # empty = stderr only
KALSHI_DECISION_JOURNAL=              # e.g. decisions.jsonl (SignalDecision per coin per cycle)
KALSHI_DASHBOARD_PORT=8000

# ---- perp telemetry / research (read by kalshi_dashboard.py; defaults shown) ----
KALSHI_PERP_TELEMETRY=1               # 0 disables the passive perp recorder
KALSHI_PERP_SHADOW=1                  # 0 disables the Step 4 shadow journal
# KALSHI_PERP_API_BASE=https://external-api.kalshi.com/trade-api/v2
# KALSHI_PERP_TICKER_BTC=             # only if auto-discovery is ambiguous (also _ETH, _SOL, _XRP)
# PERP_LIVE_VETO_KILL_FILE=DISABLE_PERP_LIVE_VETO
# PERP_LIVE_VETO_ENABLED is deliberately NOT read from .env by run_local.py: set it in the shell
# only, and only after a validated manual promotion (see PRODUCTION_RUNBOOK.txt).

# ---- SECRETS (leave empty here; set in your shell or a private .env) ----
# Legacy optional Discord adapter (kalshi_bot.py) only:
DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=  DISCORD_STATUS_CHANNEL_ID=  DISCORD_CALLS_CHANNEL_ID=
# DISCORD_JOURNAL_CHANNEL_ID=  DISCORD_EXPLAIN_CHANNEL_ID=
# kalshi_api_learn.py only (read-only on prod; orders demo + DRY_RUN only):
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem
KALSHI_ENV=demo
